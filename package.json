{
  "name": "revify-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Revify 15s vertical promo built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render RevifyPromo out/revify-promo.mp4 --codec=h264 --video-bitrate=30M --pixel-format=yuv420p --x264-preset=slow --image-format=png",
    "still": "remotion still RevifyPromo out/frame.png --frame=300",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "@remotion/paths": "4.0.290",
    "@remotion/tailwind": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "typescript": "5.7.3"
  }
}
